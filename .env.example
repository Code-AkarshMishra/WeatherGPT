# ============================================================
# WeatherGPT — Environment Variables
# Copy this file to .env and fill in all values.
# The server will REFUSE TO START if any required key is missing.
# ============================================================

# --- Server ---
PORT=5001
NODE_ENV=development

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017/weathergpt

# --- JWT ---
JWT_SECRET=replace_with_a_long_random_string_min_32_chars
JWT_REFRESH_SECRET=replace_with_another_long_random_string_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- Weather API (OpenWeatherMap) ---
# Get a free key at: https://openweathermap.org/api
WEATHER_API_KEY=1c495756f3f9ff2552bba8c73a2d3c65

# --- Gemini API (Google) ---
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Per-Role API Keys ---
# These are injected into the role-specific prompt context.
# You can use the same GEMINI_API_KEY for all roles initially,
# or assign separate project keys per role for quota isolation.
CROP_ADVISORY_API_KEY=your_gemini_key_or_separate_crop_key
FLOOD_API_KEY=your_gemini_key_or_separate_flood_key
AVIATION_API_KEY=your_gemini_key_or_separate_aviation_key
MARINE_API_KEY=your_gemini_key_or_separate_marine_key
CLIMATE_API_KEY=your_gemini_key_or_separate_climate_key

# --- CORS ---
CLIENT_URL=http://localhost:5173

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
CHAT_RATE_LIMIT_MAX=30
