# WeatherGPT Backend Environment Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/weathergpt
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=super-secret-jwt-key-weathergpt-sih-2024-change-in-production
JWT_EXPIRES_IN=7d

# AI / ML FastAPI Service Gateway (Live Render Service)
AI_SERVICE_URL=https://weathergpt-aiml.onrender.com
AI_SERVICE_API_KEY=weathergpt-ai-secret-key

# IMD & Meteorological Data Providers
IMD_BASE_URL=https://mausam.imd.gov.in/backend/api
IMD_API_KEY=
MOCK_EXTERNAL_APIS=false
# When true, weather/alert endpoints refuse fabricated data (they do not invent weather).
# Set false and configure live IMD/Open-Meteo providers for production.

# Security & CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Observability
LOG_LEVEL=info
