# WeatherGPT AI/ML Service Environment Variables
APP_ENV=development
PORT=8000
LOG_LEVEL=INFO
MOCK_MODE=true

# Gemini API Keys (Multi-key rotation and fallback)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-1.5-flash
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

# Backend Trust Boundary & Internal Integration
BACKEND_INTERNAL_URL=http://localhost:5000
INTERNAL_API_SECRET=sih-weathergpt-internal-secret-2026

# Open-Meteo Live Weather & Forecast API
# (Leave empty for free tier, or paste your API key here)
OPEN_METEO_API_KEY=
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_HISTORICAL_URL=https://archive-api.open-meteo.com/v1

MODEL_DIR=./models
DATA_DIR=./data
